# ============================================================
# MindPet Docker 环境变量模板
# ------------------------------------------------------------
# 用法：复制为 docker\.env 后填入真实值
#     copy docker\.env.example docker\.env
#
# docker\.env 含密钥，务必不要提交到版本库。
# ============================================================

# ---------------- 数据库 ----------------
POSTGRES_DB=mindpet
POSTGRES_USER=postgres
# 【必填】自行设置一个强密码
POSTGRES_PASSWORD=change-me-please

# ---------------- 后端端口 ----------------
BACKEND_PORT=8080
BACKEND_MAX_HEAP=768m

# ---------------- LLM（必填）----------------
# 任意 OpenAI 兼容服务：豆包 / DeepSeek / 其他
LLM_API_KEY=sk-your-llm-api-key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ---------------- Embedding 模式 ----------------
# 实际使用哪条通路由【桌面端设置页 → Embedding 工作模式】控制（三态），
# 也可在设置页填写豆包 Embedding API Key。下面两项只是各通路的默认参数。
#
#   AUTO   = 优先本地 Ollama，不可用时自动降级豆包    ← 默认，推荐
#   OLLAMA = 强制本地，数据不出本机
#   DOUBAO = 强制云端，无需本地模型
#
# 【云端模式】不需要启动 Ollama 容器（省约 1.5GB 内存）：
#   docker compose -f docker\compose.yaml up -d
#   然后在设置页把模式设为 AUTO 或 DOUBAO，并填入豆包 Embedding Key。
#   若留空 DOUBAO_EMBEDDING_API_KEY，后端会自动回退使用 LLM_API_KEY。
#
# 【本地隐私模式】额外启动 Ollama：
#   docker compose -f docker\compose.yaml --profile local-embedding up -d
#   docker exec mindpet-ollama ollama pull bge-m3
#   （必须拉取模型，否则 AUTO 会降级到豆包、强制 OLLAMA 会停用记忆）
OLLAMA_EMBED_MODEL=bge-m3

# 豆包 Embedding（AUTO 降级 / 强制云端 时需要）
DOUBAO_EMBEDDING_API_KEY=
DOUBAO_EMBEDDING_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/embeddings/multimodal
DOUBAO_EMBEDDING_MODEL=doubao-embedding-vision-251215

# ---------------- 可选能力（留空则该功能不可用，不影响启动）----------------
# 腾讯地图：路线规划 / 地点搜索
TENCENT_MAP_API_KEY=
# 滴滴出行 MCP（https://mcp.didichuxing.com/ 申请）
DIDI_MCP_KEY=
# true = 沙箱，不产生真实订单
DIDI_MCP_SANDBOX=true
